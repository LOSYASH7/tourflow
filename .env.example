# Скопируйте в .env и задайте свои значения. Файл .env в git не попадает.

# --- PostgreSQL (используется docker-compose) ---
POSTGRES_USER=tourflow_admin
POSTGRES_PASSWORD=ChangeMeAdmin2026
POSTGRES_DB=tourflow
TOURFLOW_ETL_PASSWORD=ChangeMeEtl2026
TOURFLOW_READER_PASSWORD=ChangeMeReader2026

# Пароли — только буквы и цифры (они подставляются в строку подключения).

# --- Приложение ---
# В Docker строки подключения собирает docker-compose.yml из паролей выше.
# Для запуска без Docker раскомментируйте и подставьте пароли:
# TOURFLOW_DATABASE_URL=postgresql+psycopg://tourflow_etl:ПАРОЛЬ@localhost:5432/tourflow
# TOURFLOW_READER_DATABASE_URL=postgresql+psycopg://tourflow_reader:ПАРОЛЬ@localhost:5432/tourflow

# live — реальные источники; synthetic — офлайн-демо на синтетических данных той же структуры
TOURFLOW_SOURCE_MODE=live
# TOURFLOW_SYNTHETIC_AS_OF=2026-09-15

# Хеш пароля дашборда: python -m tourflow.cli hash-password
TOURFLOW_DASHBOARD_PASSWORD_HASH=

# Контакт для User-Agent при обращении к API (Wikimedia без него отвечает 403):
# ваш email или ссылка на репозиторий
TOURFLOW_CONTACT=asanzharovskij@bk.ru

TOURFLOW_LOG_LEVEL=INFO
